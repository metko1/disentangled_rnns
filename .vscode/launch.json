{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run current file with time",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--beta",
        "1e-3",
        "--train-steps",
        "200_000",
        "--result-path",
        "choice+feedback+sensory_time/beta=1e-3_steps=2e5"
      ]
    },
    {
      "name": "Run current file with sensory noise",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--beta",
        "1e-2",
        "--sensory-noise",
        "0.2",
        "--train-steps",
        "20_000",
        "--result-path",
        "choice+feedback+sensory/beta=1e-2_steps=2e4_noise=0.2"
      ]
    },
    {
      "name": "Debug current file with arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--beta",
        "1e-3",
        "--train-steps",
        "200",
        "--result-path",
        "history/choice+feedback/accuracy_beta=1e-3"
      ]
    },
  ]
}